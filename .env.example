# ================================================================
# ART GALLERY — ENVIRONMENT VARIABLES
# ================================================================
# Copy this file to .env.local and fill in your values.
# Run `node scripts/setup.mjs` for guided setup.
# NEVER commit .env.local to version control!
# ================================================================

# ----------------------------------------------------------------
# DATABASE — Neon PostgreSQL (free at https://neon.tech)
# ----------------------------------------------------------------
# 1. Sign up at https://neon.tech
# 2. Create a project
# 3. Copy the connection string from the dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ----------------------------------------------------------------
# NEXTAUTH — Authentication
# ----------------------------------------------------------------
# Run this to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OR use the setup script: node scripts/setup.mjs
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Your production URL (no trailing slash)
# Local: http://localhost:3000
# Production: https://yourdomain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------
# ADMIN CREDENTIALS
# ----------------------------------------------------------------
# Username for the admin panel login
ADMIN_USERNAME="admin"

# Bcrypt hash of your admin password
# Generate with: node scripts/setup.mjs  (easiest)
# OR: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="REPLACE_WITH_BCRYPT_HASH"

# ----------------------------------------------------------------
# EMAIL — Gmail SMTP
# ----------------------------------------------------------------
# Use your Gmail address + an App Password (NOT your regular password)
# How to get App Password:
#   1. Enable 2-Step Verification on your Google Account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create an app password for "Mail"
#   4. Copy the 16-character code (no spaces needed)

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Where customer inquiries will be sent (can be the same as SMTP_USER)
EMAIL_TO="your@gmail.com"

# Display name in outgoing emails
EMAIL_FROM="Your Gallery Name <your@gmail.com>"

# ----------------------------------------------------------------
# CLOUDINARY — Image Storage (free at https://cloudinary.com)
# ----------------------------------------------------------------
# 1. Sign up at https://cloudinary.com (free tier: 25GB storage)
# 2. Go to Dashboard → copy your Cloud Name, API Key, API Secret

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Public (used in browser for displaying images — safe to expose)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ----------------------------------------------------------------
# SITE CONFIG — Public Variables
# ----------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Gallery Name"
NEXT_PUBLIC_SITE_TAGLINE="Original Art. Timeless Stories."

# Your production URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
