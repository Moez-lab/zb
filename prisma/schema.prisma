generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artwork {
  id            String   @id @default(cuid())
  title         String
  category      String
  price         Float
  medium        String
  width         Float
  height        Float
  unit          String   @default("inches")
  framing       String
  description   String
  imageUrl      String
  imagePublicId String   @default("")
  customWork    Boolean  @default(true)
  featured      Boolean  @default(false)
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([available])
}

model About {
  id            String   @id @default("singleton")
  name          String
  title         String   @default("Artist")
  bio           String
  photoUrl      String
  photoPublicId String   @default("")
  instagram     String   @default("")
  email         String   @default("")
  updatedAt     DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  artworkId String
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
